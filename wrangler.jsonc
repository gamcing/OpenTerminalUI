{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openterminalui",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-09",
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
