{
  "name": "openterminalui-container-test",
  "main": "container-worker.mjs",
  "compatibility_date": "2026-11-09",
  "containers": [
    { "class_name": "OpenTerminalContainer", "scheduling_policy": "durable_object", "images": { "base": { "dockerfile": "../Dockerfile", "build_context": ".." } } }
  ],
  "durable_objects": { "bindings": [ { "name": "APP_CONTAINER", "class_name": "OpenTerminalContainer" } ] },
  "exports": { "OpenTerminalContainer": { "type": "durable-object", "storage": "sqlite" } },
  "d1_databases": [
    { "binding": "DB", "database_name": "openterminalui-d1-test", "database_id": "00000000-0000-0000-0000-000000000001" }
  ]
}
